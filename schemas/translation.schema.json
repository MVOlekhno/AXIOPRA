{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axiopra:schema:translation:0.1.0",
  "title": "AXIOPRA Synchronized Translation Front Matter",
  "description": "Schema for a non-canonical localized Markdown document paired with one canonical AXIOPRA artifact.",
  "type": "object",
  "required": ["translation"],
  "additionalProperties": false,
  "properties": {
    "translation": {
      "type": "object",
      "required": [
        "schema_version",
        "locale",
        "source_path",
        "source_artifact",
        "source_version",
        "status",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?:docs|rfcs)/.+\\.md$"
        },
        "source_artifact": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,15}(?:-[A-Z0-9]+)+$"
        },
        "source_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "status": {
          "enum": ["draft", "review", "synchronized", "stale"]
        },
        "method": {
          "enum": ["human", "llm-assisted", "machine-assisted"]
        },
        "reviewed_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "synchronized"}
            },
            "required": ["status"]
          },
          "then": {
            "required": ["reviewed_by", "reviewed_at"],
            "properties": {
              "reviewed_by": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
